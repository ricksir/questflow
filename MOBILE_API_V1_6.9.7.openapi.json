{
  "openapi": "3.1.0",
  "info": {
    "title": "QuestFlow Mobile API",
    "version": "1.0.5",
    "description": "Contrato questflow.mobile.v1 usado pelo QuestFlow Studio 6.9.7 e QuestFlow Mobile 0.4. Adiciona triagem pré-resposta para correção de questão e assunto ainda não estudado, preservando Studio local e Cloud Bridge."
  },
  "paths": {
    "/api/v1/mobile/health": {
      "get": {
        "summary": "Saúde e descoberta mínima da API; público para pareamento",
        "security": []
      }
    },
    "/api/v1/mobile/pairing/exchange": {
      "post": {
        "summary": "Trocar token de pareamento por sessão mobile",
        "security": []
      }
    },
    "/api/v1/mobile/bootstrap": {
      "get": {
        "summary": "Bootstrap mobile"
      }
    },
    "/api/v1/mobile/today": {
      "get": {
        "summary": "Prioridade do dia"
      }
    },
    "/api/v1/mobile/priorities": {
      "get": {
        "summary": "Prioridades por matéria"
      }
    },
    "/api/v1/mobile/progress": {
      "get": {
        "summary": "Progresso mobile"
      }
    },
    "/api/v1/mobile/question-batches": {
      "post": {
        "summary": "Criar lote de questões"
      }
    },
    "/api/v1/mobile/questions/{question_id}": {
      "get": {
        "summary": "Obter revisão da questão",
        "parameters": [
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/mobile/events:batch": {
      "post": {
        "summary": "Enviar eventos idempotentes"
      }
    },
    "/api/v1/mobile/attempts/{attempt_id}/feedback": {
      "get": {
        "summary": "Feedback após resposta",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/mobile/sync": {
      "get": {
        "summary": "Pull por cursor"
      },
      "post": {
        "summary": "Push + pull offline-first"
      }
    },
    "/api/v1/mobile/devices/push-token": {
      "post": {
        "summary": "Registrar push token"
      }
    },
    "/api/v1/mobile/devices/{device_id}": {
      "delete": {
        "summary": "Desconectar o próprio aparelho",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/mobile/channels/telegram": {
      "get": {
        "summary": "Consultar estado do canal Telegram"
      },
      "put": {
        "summary": "Pausar ou retomar novas questões do Telegram"
      },
      "post": {
        "summary": "Pausar ou retomar novas questões do Telegram (compatibilidade)"
      }
    },
    "/api/v1/mobile/cloud/status": {
      "get": {
        "summary": "Status do transporte Mobile Cloud Bridge (Gateway)"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LearningEvent": {
        "type": "object",
        "required": [
          "event_id",
          "event_type"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "event_type": {
            "type": "string",
            "enum": [
              "session_started",
              "session_ended",
              "question_presented",
              "question_opened",
              "answer_selected",
              "answer_changed",
              "answer_submitted",
              "confidence_reported",
              "difficulty_reported",
              "result_seen",
              "explanation_opened",
              "explanation_finished",
              "learning_gap_reported",
              "question_skipped",
              "question_correction_requested",
              "topic_not_studied_reported",
              "topic_study_completed",
              "hint_requested",
              "scaffold_used"
            ]
          },
          "device_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "attempt_id": {
            "type": "string"
          },
          "exam_project_id": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "question_revision": {
            "type": "integer",
            "minimum": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "sequence_no": {
            "type": "integer"
          },
          "client": {
            "type": "object"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-questflow-transports": {
    "studio_lan": {
      "protocol": "questflow.mobile.v1",
      "pairing": true,
      "authoritative_learning_engine": true
    },
    "cloud_bridge": {
      "protocol": "questflow.mobile.cloud.v1",
      "pairing": false,
      "authoritative_learning_engine": false,
      "feedback_may_be_provisional": true
    }
  }
}
