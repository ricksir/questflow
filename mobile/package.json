{
  "name": "questflow-mobile",
  "version": "0.15.6",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:core": "tsc src/lib/config.ts src/lib/timing.ts src/lib/format.ts src/lib/pairing.ts src/lib/networkDiscovery.ts src/lib/studySession.ts --ignoreConfig --target ES2022 --module commonjs --outDir .core-test-build --lib ES2022,DOM --strict && node scripts/test-core.mjs && node scripts/cleanup-core.mjs"
  },
  "dependencies": {
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~7.0.2"
  }
}
